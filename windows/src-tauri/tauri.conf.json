{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadeep",
  "mainBinaryName": "Roadeep",
  "version": "0.1.7",
  "identifier": "com.roadeep.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Roadeep",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/roadeep-hook.exe": "roadeep-hook.exe",
      "../target/release/roadeep-mcp.exe": "roadeep-mcp.exe",
      "../computer-runtime/": "computer-runtime/",
      "../local-ai-bundle/": "local-ai-packages/"
    },
    "copyright": "© Louis Raille — Roadeep edition",
    "category": "DeveloperTool",
    "shortDescription": "Roadeep desktop companion at the top of your screen",
    "longDescription": "Roadeep for Windows lives at the top of your screen: chat with Roadeep and your agents, follow and approve your Claude Code sessions, keep an eye on your integrations, and drop files in — without leaving what you are doing.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
