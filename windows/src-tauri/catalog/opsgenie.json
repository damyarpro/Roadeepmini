{
  "schema": 1,
  "id": "opsgenie",
  "name": "Opsgenie",
  "category": "monitoring",
  "color": "#2684FF",
  "desc": {
    "fa": "هشدارهای باز Opsgenie؛ هشدار مهم تازه که بیاید خبرت می‌کند.",
    "en": "Open Opsgenie alerts; tells you when a new high-priority one fires."
  },
  "keyUrl": "https://support.atlassian.com/opsgenie/docs/api-key-management/",
  "docsUrl": "https://docs.opsgenie.com/docs/alert-api",
  "fields": [
    {
      "name": "token",
      "kind": "secret",
      "label": { "fa": "کلید API", "en": "API key" },
      "placeholder": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
      "optional": false,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "help": {
        "fa": "کلید یک ⁨API integration⁩ با دسترسی ⁨Read⁩ (حساب‌های آمریکا؛ منطقهٔ اروپا پشتیبانی نمی‌شود).",
        "en": "The key of an API integration with Read access (US accounts; the EU region isn't supported)."
      }
    }
  ],
  "auth": [{ "type": "header", "name": "Authorization", "field": "token", "prefix": "GenieKey " }],
  "hosts": ["api.opsgenie.com"],
  "request": {
    "method": "GET",
    "url": "https://api.opsgenie.com/v2/alerts",
    "query": { "query": "status:open", "limit": "20", "sort": "createdAt", "order": "desc" }
  },
  "list": {
    "path": "/data",
    "max": 10,
    "sort": "time",
    "id": "/id",
    "title": "/message",
    "subtitle": "/source",
    "status": "/priority",
    "time": "/createdAt"
  },
  "statusMap": { "P1": "err", "P2": "err", "P3": "warn", "P4": "info", "P5": "info" },
  "pollEvery": 60,
  "notify": { "on": "new", "statuses": ["err"] }
}
