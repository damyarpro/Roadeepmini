{
  "name": "roadeep-windows",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p roadeep-hook -p roadeep-mcp",
    "prebuild": "cargo build --release -p roadeep-hook -p roadeep-mcp",
    "pack": "node scripts/pack.mjs",
    "version": "node scripts/version.mjs",
    "test": "vitest run",
    "test:release": "vitest run --config scripts/vitest.config.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "happy-dom": "^18.0.1",
    "typescript": "^5.6.0",
    "vite": "^6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
